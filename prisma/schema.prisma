// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model users {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(32)
  email      String   @unique(map: "email") @db.VarChar(32)
  password   String   @db.VarChar(64)
  role       String   @db.VarChar(16)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  subscription subscriptions[]

  @@map("users")
}

model membership_plans {
  id            Int    @id @default(autoincrement())
  name          String @db.VarChar(32)
  price         Int
  duration_days Int
  description   String @db.VarChar(255)

  subscription subscriptions[]

  @@map("membership_plans")
}

model subscriptions {
  id            Int      @id @default(autoincrement())
  user_id       Int
  membership_id Int
  start_date    DateTime
  end_date      DateTime
  status        String   @db.VarChar(12)

  user            users            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  membership_plan membership_plans @relation(fields: [membership_id], references: [id], onDelete: Restrict)

  @@map("subscriptions")
}
